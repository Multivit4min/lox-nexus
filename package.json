{
  "name": "lox-nexus",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lox-nexus/server",
    "dev:web": "npm run dev -w @lox-nexus/web",
    "dev:web:hmr": "npm run dev:hmr -w @lox-nexus/web",
    "reset-password": "npm run reset-password -w @lox-nexus/server --",
    "docs:build": "npm run build -w @lox-nexus/docs",
    "plugins:build": "npm run build -w plugins --if-present -- --log-level=warning",
    "docs:dev": "npm run dev -w @lox-nexus/docs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @lox-nexus/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --conditions=@lox-nexus/source --import tsx --test --test-timeout=120000 \"packages/*/src/**/*.test.ts\" \"apps/server/src/**/*.test.ts\" \"apps/web/src/**/*.test.ts\" \"apps/web/build/**/*.test.ts\" \"apps/docs/src/**/*.test.ts\" \"plugins/*/src/**/*.test.ts\"",
    "ici-lab": "node --conditions=@lox-nexus/source --import tsx packages/ici/src/lab/main.ts",
    "api:report": "npm run api:report -w @lox-nexus/plugin-sdk",
    "api:check": "npm run api:check -w @lox-nexus/plugin-sdk"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@stylistic/eslint-plugin": "^2.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^14.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
