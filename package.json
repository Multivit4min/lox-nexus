{
  "name": "lox-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lox-nexus/server",
    "dev:web": "npm run dev -w @lox-nexus/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @lox-nexus/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --conditions=@lox-nexus/source --import tsx --test \"packages/*/src/**/*.test.ts\" \"apps/server/src/**/*.test.ts\" \"plugins/*/src/**/*.test.ts\"",
    "ici-lab": "node --conditions=@lox-nexus/source --import tsx packages/ici/src/lab/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@stylistic/eslint-plugin": "^2.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
