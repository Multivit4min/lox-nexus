{
  "name": "@lox-nexus/plugin-homeassistant",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Home Assistant plugin for Lox Nexus",
  "type": "module",
  "loxNexus": {
    "apiVersion": 1,
    "id": "homeassistant",
    "entry": "dist/plugin.js",
    "name": "Home Assistant",
    "icon": "home"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --conditions=@lox-nexus/source --outfile=dist/plugin.js"
  },
  "dependencies": {
    "@lox-nexus/plugin-sdk": "*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "ws": "^8.22.0"
  }
}
